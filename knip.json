{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "dotenv",
        "zod"
      ]
    },
    "packages/grillhouse": {
      "entry": [
        "bin/*.mjs",
        "scripts/**/*.mjs"
      ],
      "project": [
        "bin/*.mjs",
        "scripts/**/*.mjs",
        "tests/**/*.ts"
      ]
    },
    "packages/grillhouse/scripts/vitest-config": {
      "entry": [
        "*.mjs"
      ],
      "project": [
        "*.mjs"
      ]
    }
  },
  "ignore": [
    "mods/**",
    "templates/**"
  ],
  "ignoreBinaries": [
    "bd",
    "bwrap",
    "claude",
    "codegraph",
    "mkfifo",
    "pm2"
  ],
  "ignoreUnresolved": [
    "./.dependency-cruiser.projet.cjs"
  ]
}
