{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": ["dotenv", "zod"],
      "dependency-cruiser": {
        "config": [".dependency-cruiser.cjs"]
      }
    },
    "packages/grillhouse": {
      "entry": [
        "bin/*.mjs",
        "scripts/**/*.mjs",
        "src/temporal/commande.ts",
        "src/temporal/circuit/commande.ts",
        "src/temporal/travailleur.ts",
        "src/temporal/deroules.ts",
        "src/temporal/sonde/activites.ts",
        "src/temporal/places/activites.ts",
        "src/temporal/circuit/activites.ts",
        "src/temporal/file/activites.ts",
        "src/temporal/tickets/activites.ts",
        "tests/temporal/acte-d-essai.mjs",
        "tests/temporal/acte-en-panne.mjs",
        "tests/temporal/acte-qui-dure.mjs",
        "tests/temporal/enregistrer-la-base-de-reference.mjs",
        "tests/temporal/relais-lent.mjs"
      ],
      "project": [
        "bin/*.mjs",
        "scripts/**/*.mjs",
        "tests/**/*.ts",
        "src/**/*.ts",
        "tests/temporal/**/*.mjs"
      ]
    },
    "packages/grillhouse-essais": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["tests/**/*.ts"]
    },
    "packages/grillhouse-matiere": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["mods/**", "templates/**", "website/**"],
  "ignoreBinaries": [
    "bd",
    "bwrap",
    "claude",
    "codegraph",
    "mkfifo",
    "pm2",
    "rustc",
    "sccache",
    "systemd-run",
    "uv"
  ],
  "ignoreUnresolved": ["./.dependency-cruiser.projet.cjs"]
}
