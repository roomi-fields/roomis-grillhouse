{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "dotenv",
        "zod"
      ],
      "dependency-cruiser": {
        "config": [
          ".dependency-cruiser.cjs"
        ]
      }
    },
    "packages/grillhouse": {
      "entry": [
        "bin/*.mjs",
        "scripts/**/*.mjs"
      ],
      "project": [
        "bin/*.mjs",
        "scripts/**/*.mjs",
        "tests/**/*.ts"
      ]
    },
    "packages/grillhouse-essais": {
      "entry": [
        "tests/**/*.spec.ts"
      ],
      "project": [
        "tests/**/*.ts"
      ]
    },
    "packages/grillhouse-matiere": {
      "entry": [
        "src/index.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignore": [
    "mods/**",
    "templates/**"
  ],
  "ignoreBinaries": [
    "bd",
    "bwrap",
    "claude",
    "codegraph",
    "mkfifo",
    "pm2",
    "rustc",
    "sccache"
  ],
  "ignoreUnresolved": [
    "./.dependency-cruiser.projet.cjs"
  ]
}
