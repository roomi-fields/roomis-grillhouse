// Généré par `npx grillhouse turbo-des-paquets --ecrire` depuis les package.json, le turbo.json racine et docs/agents/hors-cadre.txt ; ne pas éditer.
{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": []
    },
    "test:vitest": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/grillhouse/package.json/**"
      ]
    }
  }
}
