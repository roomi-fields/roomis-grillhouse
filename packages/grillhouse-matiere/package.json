{
  "name": "@roomi-fields/grillhouse-matiere",
  "version": "0.0.0",
  "private": true,
  "description": "Roomi's Grillhouse: the test material its packages share, by its entry ./test-fixtures",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:unit": "vitest run",
    "lint": "eslint src tests --ext .ts,.js,.mjs",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\""
  },
  "devDependencies": {
    "@roomi-fields/grillhouse": "*"
  },
  "exports": {
    "./test-fixtures": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "grillhouse": {
    "lit": [
      "packages/grillhouse/package.json"
    ]
  }
}
