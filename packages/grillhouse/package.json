{
  "name": "@roomi-fields/grillhouse",
  "version": "0.24.9",
  "description": "Roomi's Grillhouse: the frame's scripts, called by one command, grillhouse <sous-commande>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roomi-fields/roomis-grillhouse.git",
    "directory": "packages/grillhouse"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".claude-plugin",
    "METACADRE.md",
    "agents",
    "bin",
    "cadre",
    "charte.md",
    "docs",
    "hooks",
    "scripts",
    "skills",
    "tsdoc-base.json",
    "types"
  ],
  "bin": {
    "grillhouse": "bin/grillhouse.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./consommateurs": {
      "types": "./scripts/consommateurs.d.ts",
      "default": "./scripts/consommateurs.mjs"
    },
    "./dette": {
      "types": "./scripts/dette.d.ts",
      "default": "./scripts/dette.mjs"
    },
    "./paquets": {
      "types": "./scripts/paquets.d.ts",
      "default": "./scripts/paquets.mjs"
    },
    "./resultats": {
      "types": "./scripts/resultats.d.ts",
      "default": "./scripts/resultats.mjs"
    },
    "./vitest-config": {
      "types": "./scripts/vitest-config/base.d.ts",
      "default": "./scripts/vitest-config/base.mjs"
    },
    "./vitest-config/mesure": {
      "types": "./scripts/vitest-config/mesure.d.ts",
      "default": "./scripts/vitest-config/mesure.mjs"
    },
    "./tsdoc-base.json": "./tsdoc-base.json"
  },
  "scripts": {
    "prepack": "node scripts/cadre.mjs --empaqueter",
    "postpack": "node scripts/cadre.mjs --nettoyer",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@microsoft/api-extractor": "7.59.2",
    "@microsoft/api-extractor-model": "7.33.13",
    "@microsoft/tsdoc-config": "0.18.3",
    "jsonc-parser": "3.3.1",
    "semver": "^7.8.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "grillhouse": {
    "lit": [
      ".beads",
      ".claude",
      ".dependency-cruiser.cjs",
      ".eslintrc.cjs",
      ".github",
      ".mcp.json",
      "CHANGELOG.md",
      "knip.json",
      "mods",
      "package.json",
      "packages/grillhouse/bin",
      "packages/grillhouse/scripts",
      "templates",
      "tsdoc.json"
    ]
  }
}
