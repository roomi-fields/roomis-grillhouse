{
  "name": "@roomi-fields/grillhouse",
  "version": "0.33.0",
  "description": "Roomi's Grillhouse: the frame's scripts, called by one command, grillhouse <sous-commande>",
  "keywords": [
    "claude-code",
    "elephant-goldfish-model",
    "spec-driven-development",
    "ai-agents",
    "multi-agent",
    "agentic-coding",
    "code-review",
    "tdd"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roomi-fields/roomis-grillhouse.git",
    "directory": "packages/grillhouse"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".claude-plugin",
    "CHANGELOG.md",
    "METACADRE.md",
    "agents",
    "bin",
    "cadre",
    "charte.md",
    "dist",
    "docs",
    "hooks",
    "scripts",
    "skills",
    "tsdoc-base.json",
    "types"
  ],
  "bin": {
    "grillhouse": "bin/grillhouse.mjs"
  },
  "exports": {
    "./package.json": "./package.json",
    "./consommateurs": {
      "types": "./scripts/langages/typescript/consommateurs.d.ts",
      "default": "./scripts/langages/typescript/consommateurs.mjs"
    },
    "./conformite": {
      "types": "./scripts/conformite.d.ts",
      "default": "./scripts/conformite.mjs"
    },
    "./dette": {
      "types": "./scripts/dette.d.ts",
      "default": "./scripts/dette.mjs"
    },
    "./jointure": {
      "types": "./scripts/jointure.d.ts",
      "default": "./scripts/services-du-noyau.mjs"
    },
    "./paquets": {
      "types": "./scripts/paquets.d.ts",
      "default": "./scripts/paquets.mjs"
    },
    "./resultats": {
      "types": "./scripts/resultats.d.ts",
      "default": "./scripts/resultats.mjs"
    },
    "./vitest-config": {
      "types": "./scripts/langages/typescript/vitest-config/base.d.ts",
      "default": "./scripts/langages/typescript/vitest-config/base.mjs"
    },
    "./vitest-config/mesure": {
      "types": "./scripts/langages/typescript/vitest-config/mesure.d.ts",
      "default": "./scripts/langages/typescript/vitest-config/mesure.mjs"
    },
    "./vitest-config/duree": {
      "types": "./scripts/langages/typescript/vitest-config/duree.reporter.d.ts",
      "default": "./scripts/langages/typescript/vitest-config/duree.reporter.mjs"
    },
    "./tsdoc-base.json": "./tsdoc-base.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node scripts/cadre.mjs --empaqueter",
    "postpack": "node scripts/cadre.mjs --nettoyer",
    "lint": "eslint src tests --ext .ts,.js,.mjs && node scripts/lint-des-scripts.mjs ../..",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.{ts,js,mjs}\"",
    "test:unit": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "semver": "^7.8.5",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@microsoft/api-extractor": "^7.59.2",
    "@microsoft/api-extractor-model": "^7.33.13",
    "@microsoft/tsdoc-config": "^0.18.3",
    "dependency-cruiser": "^16.10.4 || ^17.0.0 || ^18.0.0",
    "jsonc-parser": "^3.3.1",
    "knip": "^6.41.0",
    "smol-toml": "^1.9.1",
    "turbo": "^2.11.8",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@microsoft/api-extractor": {
      "optional": true
    },
    "@microsoft/api-extractor-model": {
      "optional": true
    },
    "@microsoft/tsdoc-config": {
      "optional": true
    },
    "dependency-cruiser": {
      "optional": true
    },
    "jsonc-parser": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "turbo": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    },
    "smol-toml": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.59.2",
    "@microsoft/api-extractor-model": "7.33.13",
    "@microsoft/tsdoc-config": "0.18.3",
    "@roomi-fields/grillhouse-matiere": "*",
    "dependency-cruiser": "18.4.0",
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "grillhouse": {
    "lit": [
      ".beads/.gitignore",
      ".beads/config.yaml",
      ".beads/hooks/commit-msg",
      ".beads/hooks/post-checkout",
      ".beads/hooks/post-merge",
      ".beads/hooks/pre-commit",
      ".beads/hooks/pre-push",
      ".beads/hooks/prepare-commit-msg",
      ".beads/metadata.json",
      ".claude",
      ".dependency-cruiser.cjs",
      ".dependency-cruiser.projet.cjs",
      ".eslintrc.cjs",
      ".github",
      ".mcp.json",
      "knip.json",
      "mods",
      "package.json",
      "packages/grillhouse-matiere",
      "packages/grillhouse/CHANGELOG.md",
      "packages/grillhouse/bin",
      "templates",
      "tsdoc.json",
      "packages/grillhouse-essais/tests"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
