// Généré par `npx grillhouse turbo-des-paquets --ecrire` depuis les package.json, le turbo.json racine et docs/agents/hors-cadre.txt ; ne pas éditer.
{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": [],
      "inputs": [
        "package.json",
        "src/**",
        "tsconfig.build.json",
        "tsconfig.json",
        "!CHANGELOG.md"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "build",
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.beads/.gitignore",
        "$TURBO_ROOT$/.beads/config.yaml",
        "$TURBO_ROOT$/.beads/hooks/commit-msg",
        "$TURBO_ROOT$/.beads/hooks/post-checkout",
        "$TURBO_ROOT$/.beads/hooks/post-merge",
        "$TURBO_ROOT$/.beads/hooks/pre-commit",
        "$TURBO_ROOT$/.beads/hooks/pre-push",
        "$TURBO_ROOT$/.beads/hooks/prepare-commit-msg",
        "$TURBO_ROOT$/.beads/metadata.json",
        "$TURBO_ROOT$/.claude/**",
        "$TURBO_ROOT$/.dependency-cruiser.cjs",
        "$TURBO_ROOT$/.dependency-cruiser.projet.cjs",
        "$TURBO_ROOT$/.eslintrc.cjs",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.mcp.json",
        "$TURBO_ROOT$/knip.json",
        "$TURBO_ROOT$/mods/**",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/grillhouse-essais/tests/**",
        "$TURBO_ROOT$/packages/grillhouse-matiere/**",
        "$TURBO_ROOT$/packages/grillhouse/CHANGELOG.md",
        "$TURBO_ROOT$/packages/grillhouse/bin/**",
        "$TURBO_ROOT$/templates/**",
        "$TURBO_ROOT$/tsdoc.json",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/CREDITS.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/STRUCTURE.md",
        "$TURBO_ROOT$/docs/agents/**",
        "$TURBO_ROOT$/packages/grillhouse/docs/**",
        "$TURBO_ROOT$/packages/grillhouse/docs/architecture/circuit.md",
        "$TURBO_ROOT$/packages/grillhouse/docs/architecture/machine.md",
        "$TURBO_ROOT$/packages/grillhouse/scripts/**",
        "$TURBO_ROOT$/packages/grillhouse/scripts/**/*.d.ts",
        "$TURBO_ROOT$/packages/grillhouse/scripts/**/*.mjs",
        "$TURBO_ROOT$/packages/grillhouse/scripts/crochets.mjs",
        "$TURBO_ROOT$/packages/grillhouse/scripts/{activites,effets,bilan}.mjs",
        "$TURBO_ROOT$/packages/grillhouse/scripts/{circuit,transitions,seances,ticket-du-circuit}.mjs",
        "$TURBO_ROOT$/packages/grillhouse/src/**",
        "$TURBO_ROOT$/packages/grillhouse/tests/**",
        "$TURBO_ROOT$/packages/grillhouse/tests/temoins/repartition.json"
      ]
    }
  }
}
