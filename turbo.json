{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "GRILLHOUSE_RESULTATS",
    "GRILLHOUSE_CHANGEMENTS",
    "GRILLHOUSE_AVANCEMENT",
    "TMPDIR",
    "GRILLHOUSE_TRAVAILLEURS",
    "CARGO_HOME",
    "RUSTUP_HOME"
  ],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "env": ["GRILLHOUSE_TESTS"],
      "outputs": []
    },
    "//#grillhouse:gardes": {
      "dependsOn": ["@roomi-fields/grillhouse#build"],
      "outputs": [],
      "env": [
        "GRILLHOUSE_INDEX_DU_DEPOT"
      ]
    },
    "//#gardes": {
      "dependsOn": ["@roomi-fields/grillhouse#build"],
      "outputs": [],
      "env": [
        "GRILLHOUSE_INDEX_DU_DEPOT"
      ]
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    }
  }
}
