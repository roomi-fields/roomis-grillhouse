{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "GRILLHOUSE_RESULTATS",
    "GRILLHOUSE_CHANGEMENTS",
    "GRILLHOUSE_AVANCEMENT",
    "TMPDIR",
    "TEMPORAL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "env": ["GRILLHOUSE_TESTS"],
      "outputs": []
    },
    "//#grillhouse:gardes": {
      "dependsOn": [
        "@roomi-fields/grillhouse#build"
      ],
      "outputs": []
    },
    "//#gardes": {
      "dependsOn": [
        "@roomi-fields/grillhouse#build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "//#format:check": {
      "outputs": []
    },
    "//#lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
