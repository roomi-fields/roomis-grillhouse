{
  "name": "roomis-grillhouse",
  "private": true,
  "description": "Roomi's Grillhouse: the frame's repository, its package (packages/grillhouse), its mod (mods/grillhouse) and the template of a project (templates/projet)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "grillhouse hooks",
    "typecheck": "tsc --noEmit -p templates/projet",
    "test": "grillhouse tests",
    "test:unit": "vitest run",
    "test:forcer": "grillhouse tests --force",
    "lint": "eslint templates/projet/src templates/projet/tests --cache --cache-location node_modules/.cache/eslint/.eslintcache --ext .ts,.js,.mjs",
    "lint:fix": "eslint templates/projet/src templates/projet/tests --ext .ts,.js,.mjs --fix",
    "format": "prettier --write \"templates/projet/{src,tests}/**/*.{ts,js,mjs}\"",
    "format:check": "prettier --check --cache --cache-location node_modules/.cache/prettier/.prettiercache \"templates/projet/{src,tests}/**/*.{ts,js,mjs}\"",
    "interfaces": "grillhouse index-interfaces",
    "grillhouse:gardes": "grillhouse gardes-du-cadre",
    "gardes": "claude plugin test mods/grillhouse",
    "frontieres": "grillhouse frontieres",
    "api": "grillhouse interfaces-contre-code --ecrire",
    "tableau": "grillhouse tableau --texte",
    "grillhouse:maj": "grillhouse maj",
    "code-mort": "grillhouse code-mort",
    "verifier": "grillhouse verifier",
    "grillhouse:dette:inscrire": "turbo run build && GRILLHOUSE_DETTE=inscrire npm run --silent grillhouse:gardes",
    "grillhouse:dette:elaguer": "turbo run build && GRILLHOUSE_DETTE=elaguer npm run --silent grillhouse:gardes"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@roomi-fields/grillhouse": "*",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "knip": "^6.41.0",
    "prettier": "^3.2.0",
    "turbo": "2.11.8",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "zod": "^3.22.0"
  },
  "packageManager": "npm@10.9.8",
  "grillhouse": {
    "outil": "0.32.0",
    "flux": {
      ".github/workflows/ci.yml": [
        "@roomi-fields/grillhouse",
        "@roomi-fields/grillhouse-essais",
        "@roomi-fields/grillhouse-matiere"
      ],
      ".github/workflows/deploy-docs.yml": [
        "@roomi-fields/grillhouse"
      ],
      ".github/workflows/release.yml": [
        "@roomi-fields/grillhouse"
      ]
    },
    "circuits": 2
  }
}
