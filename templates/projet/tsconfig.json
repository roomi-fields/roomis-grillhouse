{
  // The typing of the project, its sources and its tests, nothing emitted (`npm run typecheck`,
  // which `npm run verifier` plays); tsconfig.build.json builds src/ into dist/.
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Modules */
    "module": "Node16",
    "moduleResolution": "Node16",
    "resolveJsonModule": true,

    /* JavaScript — a JS project, or one migrating to TS, compiles as is */
    "allowJs": true,
    "checkJs": false,

    /* Emit: none, tsconfig.build.json builds */
    "noEmit": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    /* Type Checking */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Completeness */
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
